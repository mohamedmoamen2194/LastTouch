# Auth (Clerk)
# Development keys start with pk_test_/sk_test_ (shows "Development mode" badge).
# Production keys start with pk_live_/sk_live_ (badge disappears).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional but recommended: pin the sign-in/up URLs so auth.protect()
# redirects to the localized pages instead of Clerk's hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/en/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/en/auth/sign-up
# Required for production on *.vercel.app (no CNAME possible there):
# routes Clerk Frontend API through the app itself via /__clerk.
NEXT_PUBLIC_CLERK_PROXY_URL=https://last-touch.vercel.app/__clerk

# Database (Neon PostgreSQL)
DATABASE_URL=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Payments (Paymob)
PAYMOB_API_KEY=
PAYMOB_HMAC=

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic

# Marketplace
PLATFORM_URL=https://lasttouch.app